		"he": "^1.2.0",
		"lucide-svelte": "^1.0.0",
		"remark-preview": "^1.0.2",
		"satori": "^0.26.0",
		"satori-html": "^0.3.2",
		"shiki": "^3.0.0",
		"svelte-eslint-parser": "^1.0.0",
		"sveltekit-embed": "^0.0.22",
		"valibot": "^1.1.0"
	}
